---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HomeHero from '../components/home/HomeHero.astro';
import TrophyCase from '../components/home/TrophyCase.astro';
import ProofBand from '../components/home/ProofBand.astro';
import EventLeaders from '../components/home/EventLeaders.astro';
import RecruitingBoard from '../components/home/RecruitingBoard.astro';
import Schedule from '../components/Schedule.astro';
import CoachesSection from '../components/CoachesSection.astro';
import HomeCTA from '../components/home/HomeCTA.astro';
import Footer from '../components/Footer.astro';

import team from '../data/team.json';
---

<Layout
  title={`${team.name} | 16U PGF Georgia Co-Champions`}
  description={`2026 PGF Georgia Show Me The Money 16U co-champions and Alliance Tier 3 national runner-up. ${team.location} travel softball, formerly Stars National Walker.`}
>
  <Header transparent />
  <main>
    <HomeHero />
    <TrophyCase />
    <ProofBand />
    <EventLeaders />
    <RecruitingBoard />
    <Schedule />
    <CoachesSection />
    <HomeCTA />
  </main>
  <Footer />
</Layout>

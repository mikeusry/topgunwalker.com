---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HomeHero from '../components/home/HomeHero.astro';
import TrophyCase from '../components/home/TrophyCase.astro';
import ProofBand from '../components/home/ProofBand.astro';
import EventLeaders from '../components/home/EventLeaders.astro';
import RecruitingBoard from '../components/home/RecruitingBoard.astro';
import Schedule from '../components/Schedule.astro';
import CoachesSection from '../components/CoachesSection.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

import team from '../data/team.json';
---

<Layout
  title={`${team.name} | ${team.division} | PGF Georgia Show Me The Money Co-Champions`}
  description={`${team.name} (formerly Stars National Walker) is an elite ${team.division} travel softball team based in ${team.location}. 2026 PGF Georgia Show Me The Money 16U co-champions and 2026 Alliance National Tier 3 runner-up. View the recruiting board, schedule, and coaching staff led by Joe Walker.`}
>
  <Header transparent />
  <main>
    <HomeHero />
    <TrophyCase />
    <ProofBand />
    <EventLeaders />
    <RecruitingBoard />
    <Schedule />
    <CoachesSection />
    <Contact />
  </main>
  <Footer />
</Layout>

---
// Coach-first homepage hero: the latest title, not the rename.
// All copy comes from src/data/feature-result.json.
import r from '../../data/feature-result.json';

const wins = r.bracket.length;
const oneRun = r.bracket.filter((g) => g.us - g.them === 1).length;
const runsFor = r.bracket.reduce((s, g) => s + g.us, 0);
const runsAgainst = r.bracket.reduce((s, g) => s + g.them, 0);
---

<section class="hh relative isolate overflow-hidden bg-tg-navy-deep text-white mt-[72px]">
  <img
    src={r.photo}
    alt={r.photoAlt}
    width="1500"
    height="957"
    class="hh-photo absolute inset-0 -z-10 h-full w-full object-cover object-[50%_35%]"
    fetchpriority="high"
    loading="eager"
  />
  <div class="hh-shade absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-narrow relative pt-16 pb-10 md:pt-28 md:pb-14">
    <p class="hh-kicker">
      <span class="hh-wing" aria-hidden="true"></span>
      {r.event} · {r.dates}
    </p>

    <h1 class="hh-title">
      <span class="block text-white/90">{r.headline.split(' ')[0]}</span>
      <span class="block text-tg-orange">{r.headline.split(' ').slice(1).join(' ')}</span>
    </h1>

    <p class="mt-5 max-w-xl text-lg md:text-xl text-white/85">
      Top Gun National Walker went {wins}-0 through bracket play at {r.location}, with {oneRun} of those
      wins decided by a single run. Shared title with {r.coChampion}.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row gap-3">
      <a href="#board" class="hh-btn hh-btn--primary">Scout the roster</a>
      <a href={r.source.url} target="_blank" rel="noopener" class="hh-btn hh-btn--ghost">
        Read the recap · {r.source.name}
      </a>
    </div>

    <p class="mt-6 text-xs uppercase tracking-[0.2em] text-white/50">
      Formerly Stars National Walker · Charlotte, NC
    </p>
  </div>

  <!-- Scoreboard: the bracket run -->
  <div class="relative border-t border-white/10 bg-black/45 backdrop-blur-sm">
    <div class="container-narrow py-5">
      <div class="flex items-baseline justify-between gap-4 mb-3">
        <h2 class="hh-board-label">Bracket run</h2>
        <p class="text-xs text-white/60 font-mono">RUNS {runsFor}–{runsAgainst}</p>
      </div>
      <ol class="hh-board">
        {r.bracket.map((g, i) => (
          <li class="hh-game" style={`--d:${i * 90}ms`}>
            <span class="hh-w">W</span>
            <span class="hh-score">{g.us}–{g.them}</span>
            <span class="hh-opp">{g.opponent}</span>
          </li>
        ))}
        <li class="hh-game hh-game--final" style={`--d:${wins * 90}ms`}>
          <span class="hh-w hh-w--crown">★</span>
          <span class="hh-score">FINAL</span>
          <span class="hh-opp">Co-champions</span>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .hh-shade {
    background:
      linear-gradient(90deg, rgb(20 32 74 / 0.96) 0%, rgb(20 32 74 / 0.82) 38%, rgb(20 32 74 / 0.25) 75%, rgb(20 32 74 / 0.1) 100%),
      linear-gradient(0deg, rgb(20 32 74 / 0.9) 0%, transparent 45%);
  }
  @media (max-width: 767px) {
    .hh-shade { background: linear-gradient(0deg, rgb(20 32 74 / 0.97) 30%, rgb(20 32 74 / 0.55) 100%); }
  }
  .hh-photo { animation: hh-zoom 14s ease-out both; }
  @keyframes hh-zoom { from { transform: scale(1.08); } to { transform: scale(1); } }

  .hh-kicker {
    display: flex; align-items: center; gap: 12px;
    font-family: var(--font-heading); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.16em; font-size: 13px;
    color: var(--color-tg-orange);
  }
  .hh-wing {
    width: 44px; height: 10px; flex: none;
    background: repeating-linear-gradient(180deg, var(--color-tg-orange) 0 2px, transparent 2px 4px);
    clip-path: polygon(0 0, 100% 0, 85% 100%, 0 100%);
  }
  .hh-title {
    margin-top: 14px;
    font-family: var(--font-heading); font-weight: 700;
    text-transform: uppercase; line-height: 0.88; letter-spacing: -0.01em;
    font-size: clamp(56px, 11vw, 132px);
  }
  .hh-title span { animation: hh-rise 0.7s cubic-bezier(.2,.8,.2,1) both; }
  .hh-title span + span { animation-delay: 0.12s; }
  /* Transform only — never start from opacity 0, so text is visible even if the animation never runs. */
  @keyframes hh-rise { from { transform: translateY(18px); } to { transform: none; } }

  .hh-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 14px 26px; font-weight: 700; border-radius: 4px;
    text-transform: uppercase; letter-spacing: 0.06em; font-size: 14px;
    transition: transform .15s ease, background-color .15s ease, color .15s ease;
  }
  .hh-btn:hover { transform: translateY(-1px); }
  .hh-btn--primary { background: var(--color-tg-orange); color: #fff; }
  .hh-btn--primary:hover { background: #c94f23; }
  .hh-btn--ghost { border: 2px solid rgb(255 255 255 / 0.6); color: #fff; }
  .hh-btn--ghost:hover { background: #fff; color: var(--color-tg-navy); }

  .hh-board-label {
    font-family: var(--font-heading); font-size: 13px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.2em; color: rgb(255 255 255 / 0.7);
  }
  .hh-board {
    display: grid; gap: 8px;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  .hh-game {
    display: grid; grid-template-columns: auto 1fr; column-gap: 10px; align-items: center;
    padding: 10px 12px; border-radius: 4px;
    background: rgb(255 255 255 / 0.06); border: 1px solid rgb(255 255 255 / 0.1);
    animation: hh-rise .5s ease-out both; animation-delay: calc(400ms + var(--d));
  }
  .hh-w {
    grid-row: span 2; width: 28px; height: 28px; display: grid; place-items: center;
    background: var(--color-tg-orange); color: #fff; font-weight: 800; font-size: 13px; border-radius: 3px;
  }
  .hh-w--crown { background: #fff; color: var(--color-tg-orange); }
  .hh-score { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-weight: 700; font-size: 20px; line-height: 1; }
  .hh-opp { font-size: 11px; line-height: 1.25; color: rgb(255 255 255 / 0.65); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .hh-game--final { background: rgb(222 94 47 / 0.18); border-color: rgb(222 94 47 / 0.6); }

  @media (prefers-reduced-motion: reduce) {
    .hh-photo, .hh-title span, .hh-game { animation: none; }
  }
</style>

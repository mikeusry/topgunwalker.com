---
// Trophy case: every title at once, newest first. The latest feature result
// leads; the rest come from schedule.pastEvents entries that carry a `result`.
// Add a title by adding a pastEvent with `result` — no edit here needed.
import r from '../../data/feature-result.json';
import schedule from '../../data/schedule.json';
import { buildCloudinaryUrl } from '../../lib/cloudinary';

type Trophy = { result: string; event: string; when: string; where: string; img?: string; href?: string; record?: string };

const feature: Trophy = {
  result: `${r.org} ${r.eventShort}`,
  event: `16U Co-Champions · ${r.region}`,
  when: r.dates,
  where: r.location,
  img: r.photo,
  href: r.source.url,
  record: r.record,
};

const past: Trophy[] = (schedule.pastEvents ?? [])
  .filter((e: any) => e.result)
  .map((e: any) => ({
    result: e.result,
    event: e.name,
    when: e.dates,
    where: e.location,
    img: e.trophyPhoto ?? (e.photos?.[0]?.publicId
      ? buildCloudinaryUrl({ publicId: e.photos[0].publicId, width: 640, height: 400, crop: 'fill', gravity: 'auto' })
      : undefined),
    href: e.featured ? '#schedule' : undefined,
  }));

const trophies = [feature, ...past];
---

<section class="tc bg-tg-navy-deep text-white border-t border-white/10">
  <div class="container-narrow py-10 md:py-12">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="tc-label">Trophy case</h2>
      <p class="hidden sm:block text-xs text-white/50 font-mono">{trophies.length} titles · newest first</p>
    </div>
    <ol class="tc-row">
      {trophies.map((t, i) => {
        const Tag = t.href ? 'a' : 'div';
        return (
          <li>
            <Tag
              class:list={['tc-tile', i === 0 && 'tc-tile--lead', !t.img && 'tc-tile--type']}
              {...(t.href ? { href: t.href, ...(t.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {}) } : {})}
            >
              {t.img && <img src={t.img} alt="" loading="lazy" class="tc-img" />}
              <div class="tc-body">
                <span class="tc-star" aria-hidden="true">★</span>
                <p class="tc-result">{t.result}</p>
                <p class="tc-event">{t.event}</p>
                <p class="tc-meta">{t.when} · {t.where}{t.record && <> · <strong>{t.record}</strong></>}</p>
              </div>
            </Tag>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .tc-label { font-family: var(--font-heading); font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .2em; color: var(--color-tg-orange); }
  .tc-row { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  @media (max-width: 640px) {
    .tc-row { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 78%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; }
    .tc-row > li { scroll-snap-align: start; }
  }
  .tc-tile { position: relative; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; min-height: 190px; border-radius: 6px; overflow: hidden; border: 1px solid rgb(255 255 255 / .12); background: rgb(255 255 255 / .04); isolation: isolate; transition: transform .18s, border-color .18s; }
  a.tc-tile:hover { transform: translateY(-3px); border-color: var(--color-tg-orange); }
  .tc-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .tc-tile:not(.tc-tile--type)::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(20 32 74 / .96) 15%, rgb(20 32 74 / .2) 100%); }
  .tc-tile--type { background: repeating-linear-gradient(-55deg, rgb(255 255 255 / .03) 0 14px, transparent 14px 28px), rgb(255 255 255 / .04); }
  .tc-tile--lead { border-color: var(--color-tg-orange); box-shadow: 0 0 0 1px var(--color-tg-orange) inset; }
  .tc-body { padding: 14px; }
  .tc-star { color: var(--color-tg-orange); font-size: 16px; }
  .tc-result { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; font-size: 22px; line-height: 1; margin-top: 4px; }
  .tc-event { font-size: 13px; color: rgb(255 255 255 / .85); margin-top: 6px; line-height: 1.25; }
  .tc-meta { font-size: 11px; color: rgb(255 255 255 / .55); margin-top: 4px; }
  .tc-meta strong { color: var(--color-tg-orange); }
</style>

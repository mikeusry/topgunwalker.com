---
// Closing call to action. Replaces the old per-coach contact cards, which
// duplicated the coaching staff section. All contact routes to web forms.
---

<section id="contact" class="cta bg-tg-navy-deep text-white py-14 md:py-20">
  <div class="container-narrow text-center">
    <span class="tg-eyebrow">Get in touch</span>
    <h2 class="cta-h2">Recruit a Top Gun</h2>
    <p class="mt-3 text-white/75 max-w-xl mx-auto">
      Video, transcripts, and schedules for any player — one form, answered by our recruiting coordinator.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/recruiting/#inquiry" class="cta-btn cta-btn--primary">College coaches: request info</a>
      <a href="/tryout/" class="cta-btn cta-btn--ghost">Players: try out</a>
    </div>
  </div>
</section>

<style>
  .cta { background-image: radial-gradient(ellipse at 50% 120%, rgb(222 94 47 / .22), transparent 60%); }
  .cta-h2 { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; font-size: clamp(34px, 6vw, 56px); line-height: .95; margin-top: 8px; }
  .cta-btn { display: inline-flex; align-items: center; justify-content: center; padding: 14px 24px; border-radius: 4px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; font-size: 14px; transition: background-color .15s, color .15s; }
  .cta-btn--primary { background: var(--color-tg-orange); color: #fff; }
  .cta-btn--primary:hover { background: #c94f23; }
  .cta-btn--ghost { border: 2px solid rgb(255 255 255 / .6); color: #fff; }
  .cta-btn--ghost:hover { background: #fff; color: var(--color-tg-navy); }
</style>
